# .env.example — copy to .env.local. NEVER commit real values.
# Firebase Web app (Project Settings → General → Your apps)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional analytics / App Check
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
NEXT_PUBLIC_FIREBASE_RECAPTCHA_SITE_KEY=

# Mentora (server-side only — never NEXT_PUBLIC)
# Any OpenAI-compatible endpoint works. Leave MENTORA_API_KEY blank to use the labeled local fallback.
MENTORA_API_KEY=
MENTORA_MODEL=gpt-4o-mini
# default: https://api.openai.com/v1
MENTORA_API_BASE_URL=
MENTORA_MAX_CONTEXT_MESSAGES=12
